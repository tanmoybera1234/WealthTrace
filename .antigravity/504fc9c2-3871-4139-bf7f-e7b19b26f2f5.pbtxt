          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return new Date(b.date).getTime() - new Date(a.date).getTime();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
