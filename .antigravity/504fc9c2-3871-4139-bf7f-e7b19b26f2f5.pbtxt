        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (sortBy === \'highest\') {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return b.amount - a.amount;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
