          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      (tx.category && tx.category.toLowerCase().includes(searchTerm.toLowerCase())) ||"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
